# Copy to .env (gitignored) and fill in.

# identify-found-items endpoint and the secret it checks (same value as edge-functions/.env)
IDENTIFY_URL=https://salsusdncqbtrkcqxdkg.supabase.co/functions/v1/identify-found-items
ROVER_INGEST_SECRET=

# id of this rover's row in the `rovers` table
ROVER_ID=

# Simulator finds should stay demo-only so they never appear to real students.
IS_DEMO=true
# true = identify only, nothing is listed
DRY_RUN=false
LOCATION_LABEL=UW Seattle campus, rover patrol

# Change gate: send a camera's image only after the rover moved / turned this much,
# or the picture changed by this many of 64 hash bits.
MOVE_MIN_M=2.0
TURN_MIN_DEG=20
IMAGE_DIFF_MIN=12
