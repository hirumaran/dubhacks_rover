# Copy to .env (gitignored) and fill in.

# identify-found-items endpoint and the secret it checks (same value as edge-functions/.env)
IDENTIFY_URL=https://salsusdncqbtrkcqxdkg.supabase.co/functions/v1/identify-found-items
ROVER_INGEST_SECRET=

# id of this rover's row in the `rovers` table
ROVER_ID=

# Simulator finds should stay demo-only so they never appear to real students.
IS_DEMO=true
# true = identify only, nothing is listed
DRY_RUN=false
LOCATION_LABEL=UW Seattle campus, rover patrol

# Change gate: send a camera's image only after the rover moved / turned this much,
# or the picture changed by this many of 64 hash bits.
MOVE_MIN_M=1.5
TURN_MIN_DEG=20
IMAGE_DIFF_MIN=12

# Detection tiles across the middle band of each frame ("1x1" = whole frame, one call).
DETECT_TILES=2x1
DETECT_BAND=0.15,0.85

# Cameras to send: 1 = left, 3 = right (benches are beside the route). "0,1,2,3" = all.
SEND_CAMERAS=1,3

# Ignore detections smaller than this (longer side, px): too far away to be reliable.
MIN_BOX_PX=48

# Optional stable site/floor name for private item geotracking (default: mission-derived).
# ITEM_TRACKING_SCOPE=gates-ground-floor
# Assumed uncertainty of triangulated item positions, in meters.
ITEM_POSITION_ACCURACY_M=2
