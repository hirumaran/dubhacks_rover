# ---- Supabase (run schema.sql in the dashboard first) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service key: rover is a trusted local writer (bypasses RLS). NEVER ship this to the web app.
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
# anon key: safe for the web branch to read sightings (RLS enforced)
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_STORAGE_BUCKET=sightings-crops

# ---- Isaac model ----
ISAAC_HF_PATH=PerceptronAI/Isaac-0.2-1B
# auto = transformers, falls back to perceptron SDK, falls back to mock
ISAAC_BACKEND=auto
ISAAC_DEVICE=auto          # auto|mps|cuda|cpu
ISAAC_MAX_SIDE=640         # downscale the 320x240 frames before the VLM
ISAAC_ENABLE_THINKING=0    # 1 = reasoning traces (slower, better on tiny objects)

# ---- Cadence / tracker tuning ----
FRAME_INTERVAL_S=5.0
INBOX_POLL_S=1.0
GONE_AFTER_S=8.0
MOVE_MIN_M=0.15
MAX_RANGE_M=6.0

# ---- Fleet + student QR kiosk ----
# Unique per physical rover. When you clone a second rover, change this.
ROVER_ID=mk1
ROVER_DISPLAY_NAME=Campus Scout MK1
# Public origin encoded INTO the printed QR. localhost is demo-only.
# After you deploy (or expose LAN IP), re-run: python tools/make_qr.py --url https://…
# Quick phone demo: python tools/make_qr.py --lan  (uses KIOSK_PORT below)
PUBLIC_APP_URL=http://localhost:8787
KIOSK_PORT=8787
# Rover is "offline" for dispatch if heartbeat older than this (seconds)
HEARTBEAT_STALE_S=45
LOST_ITEMS_BUCKET=lost-item-queries
# Minimum match_agent score before a report flips to 'matched' (0..1)
MATCH_MIN_SCORE=0.3

# ---- Test isolation (optional; tools/*_selftest set these themselves) ----
# PERCEPTION_INBOX_DIR=/tmp/perception_inbox
# PERCEPTION_STATE_DIR=/tmp/perception_state
# PERCEPTION_REPORTS_DIR=/tmp/perception_reports
