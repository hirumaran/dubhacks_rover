  "name": "huskyfind",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "publish:judging": "node scripts/run-tool.cjs qr && npm run export:web && node scripts/run-tool.cjs eas deploy --prod --non-interactive --export-dir dist-web",
    "check:judging": "node scripts/run-tool.cjs judging",
    "configure:cloud": "node scripts/configure-cloud.cjs",
    "scout:gateway": "node scripts/run-tool.cjs scout",
    "start": "node scripts/run-tool.cjs expo start --go --tunnel",
    "start:tunnel": "node scripts/run-tool.cjs expo start --go --tunnel --clear",
    "start:lan": "node scripts/run-tool.cjs expo start --go --lan --clear",
    "start:web": "node scripts/run-tool.cjs expo start --web",
    "android": "node scripts/run-tool.cjs expo run:android",
    "ios": "node scripts/run-tool.cjs expo run:ios",
    "typecheck": "node scripts/run-tool.cjs tsc --noEmit",
    "test": "node scripts/run-tool.cjs tsx --test tests/*.test.ts",
    "doctor": "node scripts/run-tool.cjs expo-doctor",
    "check:dependencies": "node scripts/run-tool.cjs expo install --check",
    "export:native": "node scripts/run-tool.cjs expo export --platform ios --platform android",
    "export:web": "node scripts/run-tool.cjs expo export --platform web --output-dir dist-web",
    "check:backend": "node scripts/run-tool.cjs backend",
    "start:dev": "node scripts/run-tool.cjs expo start --dev-client --tunnel",
    "smoke:browser": "node scripts/run-tool.cjs browser",
    "login:expo": "node scripts/run-tool.cjs expo login --browser",
    "whoami:expo": "node scripts/run-tool.cjs expo whoami"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "1.18.19",
    "node": "24.19.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
