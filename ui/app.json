{
  "expo": {
    "name": "HuskyFind",
    "slug": "huskyfind",
    "scheme": "huskyfind",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "output": "server",
      "name": "HuskyFind · UW Lost & Found",
      "shortName": "HuskyFind",
      "themeColor": "#4B2E83",
      "backgroundColor": "#FAF8FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.huskyfind.mobile"
    },
    "android": {
      "package": "edu.huskyfind.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Let Scout identify belongings using your camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of your missing item or ownership evidence.",
          "cameraPermission": "Photograph your item."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Center the campus map on your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
